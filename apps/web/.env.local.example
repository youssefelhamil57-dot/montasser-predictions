# ---------------------------------------------------------------------------
# Montasser — env template
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Public app URL (used to build sitemap absolute URLs, OG, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Your 1xBet affiliate link from 1xBet Partners. Every "Parier sur 1xBet"
# button on the feed opens this URL in a new tab. Tracking + commissions
# are handled on 1xBet's side.
NEXT_PUBLIC_BETTING_URL=https://1xbet.com/

# --- Supabase --------------------------------------------------------------
# Create a project at https://app.supabase.com, then grab these from
# Project Settings → API. Only used server-side (no client auth).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic Claude API --------------------------------------------------
# Required by the prediction generation cron.
# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- API-Football (optional) ----------------------------------------------
# Free tier: 100 req/day. Without this, the cron falls back to 3 mock fixtures.
# https://www.api-football.com
API_FOOTBALL_KEY=

# --- Cron route auth ------------------------------------------------------
# Random 32+ char string. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# automatically. In dev, you can leave it empty and curl the endpoint directly.
CRON_SECRET=

# --- Site login (single user) --------------------------------------------
# The whole site is behind a login. One identifier + one password.
AUTH_USERNAME=montasser
AUTH_PASSWORD=change_me_in_prod
# HMAC secret used to sign session cookies. 32+ hex chars: `openssl rand -hex 32`
AUTH_SECRET=
